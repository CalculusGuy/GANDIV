# GANDIV API Key Configuration
# Copy this file to .env and fill in whichever keys you have.
# Every key is OPTIONAL — GANDIV degrades gracefully and simply skips
# sources it doesn't have credentials for.

# https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# https://account.shodan.io/
SHODAN_API_KEY=

# https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# https://dehashed.com/
DEHASHED_EMAIL=
DEHASHED_API_KEY=

# https://github.com/settings/tokens (classic token, "public_repo" scope is enough)
GITHUB_TOKEN=

# --- Runtime tuning (all optional) ---
GANDIV_OUTPUT_DIR=gandiv_reports
GANDIV_TIMEOUT=10
GANDIV_MAX_RETRIES=3
GANDIV_THREADS=10
GANDIV_DEFAULT_RPS=3.0
GANDIV_DEBUG=0
